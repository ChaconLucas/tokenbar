{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenBar",
  "version": "0.4.7",
  "identifier": "app.tokenbar.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TokenBar",
        "url": "index.html",
        "width": 640,
        "height": 248,
        "minWidth": 380,
        "minHeight": 150,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Limites de IA num display de LED",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwREQ1NkMxODYwMDNEMkEKUldRcVBRQ0d3VmJkWU85NzJPRmNMUHJjT2pNVHlYUTErOG14enNGd0d2cHVwZmxqN0JxTDdsY2wK",
      "endpoints": [
        "https://github.com/ChaconLucas/tokenbar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
